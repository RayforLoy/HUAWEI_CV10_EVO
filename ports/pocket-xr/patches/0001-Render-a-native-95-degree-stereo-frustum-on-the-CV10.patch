@@ -0,0 +1,16 @@
+package com.hayeco.flipspaces.spatial
+
+import com.hayeco.flipspaces.core.spatial.GlassesOptics
+import kotlin.math.atan
+import kotlin.math.sqrt
+import kotlin.math.tan
+
+/** The square per-eye projection consumed by Monado CV10's optical preview. */
+internal object Cv10Optics {
+    const val DISPLAY_NAME = "Monado CV10 Pocket XR Optics"
+    private const val EYE_SIZE = 1600
+    private const val HALF_FOV_DEG = 47.5
+
+    private val diagonalFov = Math.toDegrees(2 * atan(sqrt(2.0) * tan(Math.toRadians(HALF_FOV_DEG))))
+    val optics = GlassesOptics(EYE_SIZE, EYE_SIZE, diagonalFov.toFloat())
+}
