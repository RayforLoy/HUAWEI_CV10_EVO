@@ -0,0 +1,36 @@
+package org.vrglass.bridge;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** JVM check of the 60-byte report layout, two-word time, integration and column-major output. */
+public final class Cv10PoseCheck {
+    private static final ByteBuffer frame = ByteBuffer.allocate(60).order(ByteOrder.LITTLE_ENDIAN);
+
+    private static void sample(Cv10Pose pose, long ns, float rate) {
+        frame.putInt(4, (int)(ns >>> 32));
+        frame.putInt(8, (int)ns);
+        frame.putFloat(36, rate);
+        if (!pose.add(frame, 60)) throw new AssertionError("Valid report rejected");
+    }
+
+    public static void main(String[] args) {
+        Cv10Pose pose = new Cv10Pose();
+        frame.put(0, (byte)1);
+        frame.putInt(12, 0);
+        frame.putInt(28, 1);
+        frame.putFloat(20, 1);
+        long t = 0xffffffffL - 100_000_000L;
+        sample(pose, t, 0);
+        for (int i = 1; i <= 1000; i++) sample(pose, t + 1_000_000L*i, 90);
+        float[] m = new float[16];
+        pose.matrix(m);
+        if (Math.abs(m[8]-1) > 0.001 || Math.abs(m[10]) > 0.001 || Math.abs(m[5]-1) > 0.001) {
+            throw new AssertionError("Expected 90 degree Y rotation, including low-word wrap");
+        }
+        if (pose.add(frame, 59)) throw new AssertionError("Accepted truncated report");
+        frame.putInt(28, 3);
+        if (pose.add(frame, 60)) throw new AssertionError("Accepted wrong gyro tag");
+        System.out.println("CV10 pose replay passed");
+    }
+}
