diff --git a/app/src/main/java/org/vrglass/bridge/Cv10Pose.java b/app/src/main/java/org/vrglass/bridge/Cv10Pose.java
new file mode 100644
index 0000000..fd80175
--- /dev/null
+++ b/app/src/main/java/org/vrglass/bridge/Cv10Pose.java
@@ -0,0 +1,60 @@
+package org.vrglass.bridge;
+
+import java.nio.ByteBuffer;
+
+/** Relative, body-to-world rotation for the 60-byte Wallex IMU report. */
+final class Cv10Pose {
+    private double w = 1, x, y, z;
+    private double refX, refY, refZ;
+    private double biasX, biasY, biasZ;
+    private long previousNs;
+
+    boolean add(ByteBuffer b, int length) {
+        if (length != 60 || b.get(0) != 1 || b.getInt(12) != 0 || b.getInt(28) != 1) return false;
+        double ax = b.getFloat(16), ay = b.getFloat(20), az = b.getFloat(24);
+        double gx = Math.toRadians(b.getFloat(32)), gy = Math.toRadians(b.getFloat(36));
+        double gz = Math.toRadians(b.getFloat(40));
+        double g = Math.sqrt(ax*ax + ay*ay + az*az);
+        if (!Double.isFinite(g) || !Double.isFinite(gx + gy + gz)) return false;
+        long ns = ((long)b.getInt(4) << 32) | (b.getInt(8) & 0xffffffffL);
+        if (previousNs == 0) {
+            if (g < 0.85 || g > 1.15 || ns <= 0) return false;
+            refX = ax/g; refY = ay/g; refZ = az/g;
+            previousNs = ns;
+            return true;
+        }
+        double dt = (ns - previousNs) * 1e-9;
+        previousNs = ns;
+        if (dt <= 0 || dt > 0.05) return false;
+        // Estimate zero rate slowly and only during near-stationary intervals.
+        if (Math.abs(g - 1) < 0.04 && gx*gx + gy*gy + gz*gz < 0.00012) {
+            double k = dt / (4 + dt);
+            biasX += k*(gx-biasX); biasY += k*(gy-biasY); biasZ += k*(gz-biasZ);
+        }
+        gx -= biasX; gy -= biasY; gz -= biasZ;
+        if (Math.abs(g - 1) < 0.12) {
+            // Rotate the reference gravity into the current headset frame.
+            double vx = (1-2*(y*y+z*z))*refX + 2*(x*y+w*z)*refY + 2*(x*z-w*y)*refZ;
+            double vy = 2*(x*y-w*z)*refX + (1-2*(x*x+z*z))*refY + 2*(y*z+w*x)*refZ;
+            double vz = 2*(x*z+w*y)*refX + 2*(y*z-w*x)*refY + (1-2*(x*x+y*y))*refZ;
+            gx += (ay*vz-az*vy)/g;
+            gy += (az*vx-ax*vz)/g;
+            gz += (ax*vy-ay*vx)/g;
+        }
+        double h = dt/2;
+        double nw = w-h*(x*gx+y*gy+z*gz);
+        double nx = x+h*(w*gx+y*gz-z*gy);
+        double ny = y+h*(w*gy+z*gx-x*gz);
+        double nz = z+h*(w*gz+x*gy-y*gx);
+        double norm = Math.sqrt(nw*nw+nx*nx+ny*ny+nz*nz);
+        w=nw/norm; x=nx/norm; y=ny/norm; z=nz/norm;
+        return true;
+    }
+
+    void matrix(float[] m) {
+        m[0]=(float)(1-2*(y*y+z*z)); m[1]=(float)(2*(x*y+w*z)); m[2]=(float)(2*(x*z-w*y)); m[3]=0;
+        m[4]=(float)(2*(x*y-w*z)); m[5]=(float)(1-2*(x*x+z*z)); m[6]=(float)(2*(y*z+w*x)); m[7]=0;
+        m[8]=(float)(2*(x*z+w*y)); m[9]=(float)(2*(y*z-w*x)); m[10]=(float)(1-2*(x*x+y*y)); m[11]=0;
+        m[12]=0; m[13]=0; m[14]=0; m[15]=1;
+    }
+}
diff --git a/app/src/main/java/org/vrglass/bridge/Cv10Tracking.java b/app/src/main/java/org/vrglass/bridge/Cv10Tracking.java
new file mode 100644
index 0000000..93a2815
--- /dev/null
+++ b/app/src/main/java/org/vrglass/bridge/Cv10Tracking.java
@@ -0,0 +1,164 @@
+package org.vrglass.bridge;
+
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.hardware.usb.*;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.util.Log;
+import android.view.View;
+import android.widget.Toast;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.TimeoutException;
+
+/** Shares one USB reader while at least one Globalka render surface is attached. */
+final class Cv10Tracking {
+    static final String TAG = "GlobalkaCV10";
+    private static final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private static final Handler main = new Handler(Looper.getMainLooper());
+    private static final float[] latest = new float[16];
+    private static long lastPoseMs;
+    private static int users;
+    private static volatile int generation;
+
+    static void attach(View surface) {
+        Context ctx = surface.getContext().getApplicationContext();
+        surface.addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
+            boolean active;
+            public void onViewAttachedToWindow(View v) {
+                if (!active) { active = true; retain(ctx); }
+            }
+            public void onViewDetachedFromWindow(View v) {
+                if (active) { active = false; release(); }
+            }
+        });
+    }
+    private static synchronized void retain(Context ctx) {
+        if (++users == 1) {
+            int token = ++generation;
+            worker.execute(() -> monitor(ctx, token));
+        }
+    }
+    private static synchronized void release() {
+        if (--users == 0) {
+            generation++;
+            lastPoseMs = 0;
+        }
+    }
+    static synchronized boolean read(float[] target) {
+        if (lastPoseMs == 0 || SystemClock.elapsedRealtime() - lastPoseMs > 500) return false;
+        System.arraycopy(latest, 0, target, 0, 16);
+        return true;
+    }
+    private static synchronized void publish(Cv10Pose pose, int token) {
+        if (generation != token) return;
+        pose.matrix(latest);
+        lastPoseMs = SystemClock.elapsedRealtime();
+    }
+    private static void notice(Context ctx, String message) {
+        Log.i(TAG, message);
+        main.post(() -> Toast.makeText(ctx, message, Toast.LENGTH_SHORT).show());
+    }
+    private static void monitor(Context ctx, int token) {
+        UsbManager usb = ctx.getSystemService(UsbManager.class);
+        if (usb == null) return;
+        int asked = -1;
+        while (token == generation) {
+            try {
+                UsbDevice device = null;
+                for (UsbDevice d : usb.getDeviceList().values()) {
+                    if (d.getVendorId() == 0x12d1 && d.getProductId() == 0x107e) { device=d; break; }
+                }
+                if (device == null) asked = -1;
+                else if (usb.hasPermission(device)) {
+                    capture(ctx, usb, device, token);
+                } else if (asked != device.getDeviceId()) {
+                    asked = device.getDeviceId();
+                    Intent intent = new Intent(ctx.getPackageName()+".USB_PERMISSION").setPackage(ctx.getPackageName());
+                    usb.requestPermission(device, PendingIntent.getBroadcast(ctx, 0, intent, PendingIntent.FLAG_IMMUTABLE));
+                    Log.i(TAG, "Requested CV10 USB permission");
+                }
+            } catch (RuntimeException error) { Log.w(TAG, "USB reader", error); }
+            SystemClock.sleep(500);
+        }
+    }
+    private static int feature(UsbDeviceConnection c, int id) {
+        byte[] data = {(byte)id, 2, 0, 0, 0};
+        return c.controlTransfer(0x21, 9, 0x0300 | id, 3, data, data.length, 500);
+    }
+    private static void capture(Context ctx, UsbManager usb, UsbDevice device, int token) {
+        for (int i=0; i<device.getInterfaceCount(); i++) {
+            UsbInterface hid=device.getInterface(i);
+            if (hid.getId()!=3 || hid.getAlternateSetting()!=0 || hid.getInterfaceClass()!=UsbConstants.USB_CLASS_HID ||
+                    hid.getInterfaceSubclass()!=0 || hid.getInterfaceProtocol()!=0) continue;
+            for (int j=0; j<hid.getEndpointCount(); j++) {
+                UsbEndpoint ep=hid.getEndpoint(j);
+                if (ep.getAddress()!=0x84 || ep.getType()!=UsbConstants.USB_ENDPOINT_XFER_INT ||
+                        ep.getMaxPacketSize()<60) continue;
+                UsbDeviceConnection c = usb.openDevice(device);
+                if (c == null) return;
+                try {
+                    if (!c.claimInterface(hid,false) && !c.claimInterface(hid,true)) return;
+                    try {
+                        if (feature(c,5)!=5) { Log.w(TAG,"IMU enable failed"); return; }
+                        try { stream(ctx,c,ep,token); }
+                        finally { Log.i(TAG,"IMU disable bytes="+feature(c,6)); }
+                    } finally { c.releaseInterface(hid); }
+                } finally { c.close(); }
+                return;
+            }
+        }
+    }
+    private static void stream(Context ctx, UsbDeviceConnection c, UsbEndpoint ep, int token) {
+        Cv10Pose pose=new Cv10Pose();
+        ByteBuffer buf=ByteBuffer.allocateDirect(ep.getMaxPacketSize()).order(ByteOrder.LITTLE_ENDIAN);
+        UsbRequest req = new UsbRequest();
+        try {
+            if (!req.initialize(c,ep)) return;
+            long count=0, received=0, start=SystemClock.elapsedRealtime(), last=start;
+            float[] diagnostic=new float[16];
+            while (token==generation) {
+                buf.clear();
+                if (!req.queue(buf)) { Log.w(TAG,"Failed to queue HID input"); return; }
+                // Timed-out waits leave the request queued. Keep the same request alive
+                // through firmware startup and short runtime gaps, without toggling the sensor.
+                long deadline = SystemClock.elapsedRealtime() + (received == 0 ? 5000 : 2500);
+                boolean completed = false;
+                while (token == generation && SystemClock.elapsedRealtime() < deadline) {
+                    try {
+                        if (c.requestWait(250) != req) { Log.w(TAG,"USB input disconnected"); return; }
+                        completed = true;
+                        break;
+                    } catch (TimeoutException waiting) { /* Still queued. */ }
+                }
+                if (!completed) {
+                    req.cancel();
+                    try { c.requestWait(250); } catch (TimeoutException ignored) { }
+                    Log.i(TAG, "IMU wait ended received="+received+" valid="+count+" stopping="+(token!=generation));
+                    return;
+                }
+                if (++received == 1) {
+                    Log.i(TAG, "firstReportMs="+(SystemClock.elapsedRealtime()-start)+" bytes="+buf.position()
+                        +" id="+(buf.position()==0 ? -1 : buf.get(0)&255));
+                }
+                if (pose.add(buf, buf.position())) {
+                    publish(pose,token);
+                    if (++count==1) notice(ctx,"CV10 head tracking active");
+                }
+                long now=SystemClock.elapsedRealtime();
+                if (now-last>=3000) {
+                    pose.matrix(diagnostic);
+                    Log.i(TAG, String.format(java.util.Locale.ROOT,
+                        "validIMU=%d received=%d elapsedMs=%d headForward=(%.3f,%.3f,%.3f)",
+                        count,received,now-start,-diagnostic[8],-diagnostic[9],-diagnostic[10]));
+                    last=now;
+                }
+            }
+        } finally { req.close(); }
+    }
+}
