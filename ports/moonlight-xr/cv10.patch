diff --git a/app/proguard-rules.pro b/app/proguard-rules.pro
index aa6ffd3..cecb81e 100644
--- a/app/proguard-rules.pro
+++ b/app/proguard-rules.pro
@@ -7,6 +7,10 @@
 # Moonlight common
 -keep class com.limelight.nvstream.jni.* {*;}
 
+# Monado loads its Kotlin Android callbacks in the client process. These
+# callbacks resolve the app's Intrinsics class through the parent loader.
+-keep class kotlin.jvm.internal.Intrinsics { *; }
+
 # LiteRT GPU delegate, loaded by name from native code. The runtime AAR
 # ships its own rules, the GPU one does not.
 -keep class org.tensorflow.lite.gpu.** {*;}
