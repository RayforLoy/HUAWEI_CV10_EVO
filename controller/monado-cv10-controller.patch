+		    std::strcmp(module->name, "SLAM") != 0 || !module->create || !module->destroy ||
+		    !module->init || !module->start || !module->stop || !module->deinit || !module->push ||
+		    !module->get || !module->register_callbacks || !module->unregister_callbacks) {
