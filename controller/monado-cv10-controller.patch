new file mode 100644
index 0000000..b24e4dd
--- /dev/null
+++ b/src/xrt/targets/openxr_android/src/main/java/org/freedesktop/monado/openxr_runtime/Cv10KitSlam.java
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.freedesktop.monado.openxr_runtime;
+
+import android.content.Context;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Process;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.Arrays;
+import java.util.Locale;
+
+/** Headset SLAM ABI for the original ARM64 SDK module. */
+final class Cv10KitSlam implements AutoCloseable {
+    private static final int PARAMETER_BYTES = 0x840;
+    private static final long SDK_MODULE_LIMIT = 16L * 1024 * 1024;
+    private static final String SDK_MODULE = "libarvr_slam.so";
+    private static final String SDK_SHA256 =
+            "2268ff5e2b26e67da395af6c57980f15f23e6199c4cb942d5fb959b3eb9b46a9";
+
+    private long session;
+
+    static File module(Context context) {
+        return new File(context.getFilesDir(), SDK_MODULE);
+    }
+
+    static void importModule(Context context, Uri source) throws IOException {
+        File destination = module(context);
+        File staging = File.createTempFile("cv10-slam-", ".tmp", context.getFilesDir());
+        try {
+            MessageDigest sha = sha256();
+            try (InputStream input = context.getContentResolver().openInputStream(source);
+                    FileOutputStream output = new FileOutputStream(staging)) {
+                if (input == null) throw new IOException("Cannot read the selected file.");
+                if (!staging.setReadOnly()) throw new IOException("Could not mark the temporary module read-only.");
+                updateDigest(input, output, sha);
+                output.getFD().sync();
+            }
+            if (!SDK_SHA256.equals(hex(sha.digest()))) {
+                throw new IOException("The selected file does not match the supported Huawei ARM64 module.");
+            }
+            // Staging and destination share a directory. renameTo replaces the old file atomically on Android.
+            if (!staging.renameTo(destination)) throw new IOException("Could not store the verified Huawei module.");
+        } finally {
+            staging.delete();
+        }
+    }
+
+    private static MessageDigest sha256() {
+        try {
+            return MessageDigest.getInstance("SHA-256");
+        } catch (NoSuchAlgorithmException impossible) {
+            throw new AssertionError(impossible);
+        }
+    }
+
+    private static void updateDigest(InputStream input, FileOutputStream output, MessageDigest sha)
+            throws IOException {
+        byte[] buffer = new byte[65536];
+        long size = 0;
+        int length;
+        while ((length = input.read(buffer)) != -1) {
+            size += length;
+            if (size > SDK_MODULE_LIMIT) throw new IOException("The Huawei module exceeds 16 MiB.");
+            if (output != null) output.write(buffer, 0, length);
+            sha.update(buffer, 0, length);
+        }
+    }
+
+    static byte[] readParameters(InputStream input) throws IOException {
+        if (input == null) throw new IOException("Cannot open the SLAM parameters.");
+        byte[] data = new byte[PARAMETER_BYTES];
+        int used = 0;
+        while (used < data.length) {
+            int read = input.read(data, used, data.length - used);
+            if (read <= 0) break;
+            used += read;
+        }
+        if (used != data.length || input.read() != -1) {
+            throw new IOException("slam-params.bin must be 2112 bytes.");
+        }
+        return data;
+    }
+
+    Cv10KitSlam(File module, byte[] parameters) throws IOException {
+        if (!Process.is64Bit() || !Arrays.asList(Build.SUPPORTED_64_BIT_ABIS).contains("arm64-v8a")) {
+            throw new IOException("An arm64-v8a process is required for the Huawei SLAM module.");
+        }
+        if (!module.isFile()) throw new IOException("Import the original ARM64 SLAM module first.");
+        MessageDigest sha = sha256();
+        try (InputStream input = new FileInputStream(module)) {
+            updateDigest(input, null, sha);
+        }
+        if (!SDK_SHA256.equals(hex(sha.digest()))) throw new IOException("The stored Huawei module failed verification.");
+        try {
+            System.loadLibrary("cv10-kit-slam");
+            session = nativeOpen(module.getAbsolutePath(), parameters);
+        } catch (UnsatisfiedLinkError unavailable) {
+            throw new IOException(unavailable.getMessage(), unavailable);
+        }
+    }
+
+    static String replayBlankFrames(Context context, byte[] parameters) throws IOException, InterruptedException {
+        try (Cv10KitSlam slam = new Cv10KitSlam(module(context), parameters)) {
+            long first = 1_000_000_000L;
+            for (int sample = 0; sample < 3; sample++) {
+                check("Head IMU", nativeImu(slam.session, first + sample * 5_000_000L, 0, 0, 9.8f, 0, 0, 0));
+            }
+            byte[] blank = new byte[Cv10KitReport.CAMERA_WIDTH * Cv10KitReport.CAMERA_HEIGHT];
+            for (int frame = 0; frame < 2; frame++) {
+                check("Y8 stereo", nativeStereo(slam.session, first + 10_000_000L + frame * 66_666_666L,
+                        frame + 1, 4000, blank, blank));
+            }
+            Thread.sleep(100);
+            return "SLAM accepted 6 IMU records and 2 blank stereo frames.\n" + slam.poseStatus();
+        }
+    }
+
+    void push(Cv10KitReport.Head head) throws IOException {
+        check("Head IMU", nativeImu(session, head.deviceNs, head.ax, head.ay, head.az, head.gx, head.gy, head.gz));
+    }
+
+    void push(Cv10KitReport.StereoFrame stereo) throws IOException {
+        Cv10KitReport.Frame frame = stereo.frame;
+        check("Y8 stereo", nativeStereo(session, frame.deviceNs, (int) frame.frameNumber, frame.exposureUs,
+                stereo.camera0, stereo.camera1));
+    }
+
+    String poseStatus() {
+        byte[] pose = new byte[Cv10KitReport.HeadPose.BYTES];
+        int status = nativePose(session, pose);
+        if (status == -1 && Arrays.equals(pose, new byte[pose.length])) {
+            return "No valid visual pose (query returned -1).";
+        }
+        Cv10KitReport.HeadPose head = Cv10KitReport.headPose(pose);
+        if (status != 0 || !head.valid()) return "Pose query returned " + status + " · " + hex(pose);
+        return String.format(Locale.ROOT,
+                "SLAM pose at %.6f s · state %d/%d\nPosition (%.4f, %.4f, %.4f) · wxyz (%.4f, %.4f, %.4f, %.4f)",
+                head.deviceSeconds, head.state0, head.state1, head.x, head.y, head.z, head.qw, head.qx, head.qy,
+                head.qz);
+    }
+
+    private static String hex(byte[] bytes) {
+        StringBuilder text = new StringBuilder(bytes.length * 2);
+        for (byte value : bytes) text.append(String.format(Locale.ROOT, "%02x", value & 0xff));
+        return text.toString();
+    }
+
+    private static void check(String operation, int result) throws IOException {
+        if (result != 0) throw new IOException(operation + " returned " + result);
+    }
+
+    @Override
+    public void close() throws IOException {
+        long active = session;
+        session = 0;
+        if (active != 0) check("SLAM stop/deinit", nativeClose(active));
+    }
+
+    private static native long nativeOpen(String library, byte[] parameters) throws IOException;
+    private static native int nativeImu(long session, long ns, float ax, float ay, float az, float gx, float gy,
+            float gz);
+    private static native int nativeStereo(long session, long ns, int frame, int exposureUs, byte[] left, byte[] right);
+    private static native int nativePose(long session, byte[] destination);
+    private static native int nativeClose(long session);
+}
diff --git a/src/xrt/targets/openxr_android/src/main/java/org/freedesktop/monado/openxr_runtime/Cv10KitSlamParameters.java b/src/xrt/targets/openxr_android/src/main/java/org/freedesktop/monado/openxr_runtime/Cv10KitSlamParameters.java
new file mode 100644
index 0000000..569bcc7
--- /dev/null
+++ b/src/xrt/targets/openxr_android/src/main/java/org/freedesktop/monado/openxr_runtime/Cv10KitSlamParameters.java
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.freedesktop.monado.openxr_runtime;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+
+/** Encodes the head SLAM module's HSDK_CONFIG_MANAGER_IMPL_GET_SLAM_PARAMS payload. */
+final class Cv10KitSlamParameters {
+    static final int SIZE = 0x840;
+    private static final int CAMERA_SIZE = 0x130;
+    private static final int[] DISTORTION_ORDER = {0, 1, 2, 5, 6, 7, 3, 4};
+
+    static byte[] encode(Cv10KitCalibration.CameraCalibration[] cameras, Cv10KitCalibration.ImuCalibration imu)
+            throws IOException {
+        ByteBuffer parameters = ByteBuffer.allocate(SIZE).order(ByteOrder.LITTLE_ENDIAN);
+        parameters.putInt(0, cameras.length);
+        for (int i = 0; i < cameras.length; i++) {
+            putCamera(parameters, 0x08 + i * CAMERA_SIZE, cameras[i]);
+        }
+        parameters.putInt(0x4c8, 1);
+        // The Android wrapper submits a nominal 1000 Hz for both sensors.
+        parameters.putFloat(0x4d4, 1000);
+        parameters.putFloat(0x4d8, 1000);
+        parameters.putDouble(0x4e0, cameras[0].cameraToImuDelaySeconds);
+        parameters.putDouble(0x4e8, cameras[0].exposureShiftSeconds);
+        for (int diagonal = 0; diagonal < 4; diagonal++) {
+            parameters.putDouble(0x4f0 + diagonal * 0x28, 1);
+        }
+
+        parameters.putInt(0x570, imu.needsCompensation ? 1 : 0);
+        double[] accel = scaleMatrix(imu.accelScale, imu.accelMisalignment);
+        double[] accelToGyro = inverseRotation(imu.gyroToAccel);
+        double[] gyro = scaleMatrix(imu.gyroScale, imu.gyroMisalignment);
+        putFloats(parameters, 0x574, multiply(accelToGyro, accel));
+        putFloats(parameters, 0x598, transformedBias(accel, imu.accelBias));
+        putFloats(parameters, 0x5a4, gyro);
+        putFloats(parameters, 0x5c8, transformedBias(gyro, imu.gyroBias));
+        parameters.putDouble(0x5d8, imu.gyroNoiseSigma);
+        parameters.putDouble(0x5e0, imu.gyroBiasSigma);
+        parameters.putDouble(0x5e8, imu.accelNoiseSigma);
+        parameters.putDouble(0x5f0, imu.accelBiasSigma);
+
+        // Common settings for the stock two-camera CV10 profile.
+        for (int i = 0; i < 5; i++) parameters.putInt(0x73c + i * 4, 1);
+        parameters.putInt(0x760, 2);
+        parameters.position(0x764);
+        parameters.put("st".getBytes(StandardCharsets.US_ASCII));
+        parameters.position(0x7f0);
+        parameters.put("20".getBytes(StandardCharsets.US_ASCII));
+        parameters.putInt(0x830, 3);
+        return parameters.array();
+    }
+
+    private static void putCamera(ByteBuffer parameters, int start, Cv10KitCalibration.CameraCalibration camera)
+            throws IOException {
+        if (camera.distortionMode > 1 || quaternionNormSquared(camera.tbc) == 0) {
+            throw new IOException("Unsupported SLAM camera model");
+        }
+        parameters.putInt(start, camera.id);
+        parameters.putInt(start + 0x04, 1);
+        parameters.putInt(start + 0x08, camera.width);
+        parameters.putInt(start + 0x0c, camera.height);
+        parameters.putInt(start + 0x10, camera.width);
+        parameters.putFloat(start + 0x14, (int) camera.framesPerSecond);
+        for (int i = 0; i < 4; i++) {
+            if (!Double.isFinite(camera.autofocusCompensation[i])) {
+                throw new IOException("Non-finite camera autofocus calibration");
+            }
+            parameters.putDouble(start + 0x18 + i * 8, camera.autofocusCompensation[i]);
+            parameters.putDouble(start + 0x40 + i * 8, camera.intrinsics[i]);
+        }
+        parameters.putInt(start + 0x60, camera.needsUndistortion ? 1 : 0);
+        parameters.putInt(start + 0x64, camera.distortionMode);
+        for (int i = 0; i < DISTORTION_ORDER.length; i++) {
+            parameters.putDouble(start + 0x68 + i * 8, camera.distortion[DISTORTION_ORDER[i]]);
+        }
+        double[] rotation = rotation(camera.tbc);
+        for (int row = 0; row < 3; row++) {
+            for (int column = 0; column < 3; column++) {
+                parameters.putDouble(start + 0xa8 + row * 0x20 + column * 8, rotation[row * 3 + column]);
+            }
+            parameters.putDouble(start + 0xc0 + row * 0x20, camera.tbc[4 + row]);
+        }
+        parameters.putDouble(start + 0x120, 1);
+        parameters.putDouble(start + 0x128, camera.readoutSeconds);
+    }
+
+    private static double quaternionNormSquared(double[] q) {
+        return q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3];
+    }
+
+    private static double[] rotation(double[] q) {
+        double x = q[0], y = q[1], z = q[2], w = q[3];
+        return new double[] {
+                w * w + x * x - y * y - z * z, 2 * (x * y - w * z), 2 * (x * z + w * y),
+                2 * (x * y + w * z), w * w - x * x + y * y - z * z, 2 * (y * z - w * x),
+                2 * (x * z - w * y), 2 * (y * z + w * x), w * w - x * x - y * y + z * z
+        };
+    }
+
+    private static double[] inverseRotation(double[] q) throws IOException {
+        double norm = quaternionNormSquared(q);
+        if (norm == 0 || !Double.isFinite(norm)) throw new IOException("Invalid gyroscope to accelerometer rotation");
+        return rotation(new double[] {-q[0] / norm, -q[1] / norm, -q[2] / norm, q[3] / norm});
+    }
+
+    private static double[] scaleMatrix(double[] scale, double[] misalignment) {
+        return new double[] {
+                scale[0], scale[0] * misalignment[0], scale[0] * misalignment[1],
+                0, scale[1], scale[1] * misalignment[2],
+                0, 0, scale[2]
+        };
+    }
+
+    private static double[] multiply(double[] left, double[] right) {
+        double[] product = new double[9];
+        for (int row = 0; row < 3; row++) {
+            for (int column = 0; column < 3; column++) {
+                for (int k = 0; k < 3; k++) {
+                    product[row * 3 + column] += left[row * 3 + k] * right[k * 3 + column];
+                }
+            }
+        }
+        return product;
+    }
+
+    private static double[] transformedBias(double[] scale, double[] bias) throws IOException {
+        if (scale[0] == 0 || scale[4] == 0 || scale[8] == 0) throw new IOException("Singular IMU scale calibration");
+        // The wrapper applies the inverse scale matrix to the negated bias.
+        double z = -bias[2] / scale[8];
+        double y = (-bias[1] - scale[5] * z) / scale[4];
+        double x = (-bias[0] - scale[1] * y - scale[2] * z) / scale[0];
+        return new double[] {x, y, z};
+    }
+
+    private static void putFloats(ByteBuffer parameters, int start, double[] values) throws IOException {
+        for (int i = 0; i < values.length; i++) {
+            float value = (float) values[i];
+            if (!Float.isFinite(value)) throw new IOException("Non-finite SLAM IMU calibration");
+            parameters.putFloat(start + 4 * i, value);
+        }
+    }
