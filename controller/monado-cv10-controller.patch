+			if (method) requested = (*env)->CallStaticBooleanMethod(env, cls, method);
+			if (jni_error(env)) requested = false;
+		}
+		(*env)->PopLocalFrame(env, NULL);
+	}
+	if (env) jni_error(env);
+	if (attached) (*vm)->DetachCurrentThread(vm);
+	return requested;
